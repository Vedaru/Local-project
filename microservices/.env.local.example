# Local overrides for one-click startup (run_with_runtime.bat)
# Copy this file to microservices/.env.local and adjust values as needed.

GATEWAY_PORT=8080
ORCHESTRATOR_PORT=8081
MEMORY_SERVICE_PORT=8082
AGENT_SERVICE_PORT=8083
VOICE_SERVICE_PORT=8084

ORCHESTRATOR_URL=http://127.0.0.1:8081
MEMORY_SERVICE_URL=http://127.0.0.1:8082
AGENT_SERVICE_URL=http://127.0.0.1:8083
VOICE_SERVICE_URL=http://127.0.0.1:8084

# Optional gateway auth (empty means disabled)
GATEWAY_API_KEY=

# Orchestrator downstream timeout and circuit-breaker tuning
ORCH_MEMORY_TIMEOUT_SEC=8
ORCH_AGENT_TIMEOUT_SEC=180
ORCH_VOICE_TIMEOUT_SEC=8
ORCH_CIRCUIT_FAIL_THRESHOLD=3
ORCH_CIRCUIT_COOLDOWN_SEC=30
