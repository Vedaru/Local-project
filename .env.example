# ==================================================
# Project Local - Environment Configuration Template
# ==================================================
# 
# 复制此文件为 .env 并填写实际的配置值
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env
#

# --------------------------------------------------
# LLM API 配置
# --------------------------------------------------
# 使用的 LLM API Key（必填）
ARK_API_KEY=your_api_key_here

# 模型名称
MODEL_NAME=your_model_name

# --------------------------------------------------
# 系统提示词
# --------------------------------------------------
# 可选：指定系统提示词文件路径
# 如果不设置，将使用默认的对话行为
SYSTEM_PROMPT_FILE=SYSTEM_PROMPT.txt

# --------------------------------------------------
# 语音合成配置
# --------------------------------------------------
# SoVITS API 地址（默认本地）
SOVITS_URL=http://127.0.0.1:9880

# --------------------------------------------------
# 浏览器 Agent 配置（OpenManus）
# --------------------------------------------------
# 如果使用浏览器控制和网页搜索功能，需要配置 OpenAI API
# OPENAI_API_KEY=sk-xxxxxx
# OPENAI_API_BASE=https://api.openai.com/v1

# --------------------------------------------------
# 日志配置
# --------------------------------------------------
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# 日志目录（默认: data/logs）
# LOG_DIR=data/logs

# --------------------------------------------------
# 性能优化配置
# --------------------------------------------------
# 禁用 CUDA（解决 ctranslate2 ROCm 路径问题）
# CT2_USE_CUDA=0

# 设置 CPU 核心数（修复中文 Windows joblib 编码问题）
# LOKY_MAX_CPU_COUNT=4

# --------------------------------------------------
# OCR 配置（可选）
# --------------------------------------------------
# Tesseract 可执行文件路径（如果不在 PATH 中）
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Tesseract 识别语言（默认: chi_sim+eng）
# TESSERACT_LANG=chi_sim+eng

# --------------------------------------------------
# 开发模式
# --------------------------------------------------
# 启用调试模式
# DEBUG=False

# 跳过某些初始化（用于快速测试）
# SKIP_AVATAR=False
# SKIP_VOICE=False
